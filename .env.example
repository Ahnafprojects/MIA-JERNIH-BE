NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://jernih:jernih@localhost:5432/jernih?schema=public"

# Minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET="ganti-dengan-32-karakter-acak-atau-lebih-jangan-dipakai-apa-adanya"
ACCESS_TTL_MENIT=15
REFRESH_TTL_HARI=30

# Asal frontend yang boleh memanggil API, dipisah koma.
CORS_ORIGIN=http://localhost:3000

# Email (verifikasi, struk token, notifikasi)
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Jernih <noreply@jernih.id>"

# Mode peragaan: beli token langsung lunas + kode token ikut dikirim.
# WAJIB false kalau pembayaran sungguhan dipasang.
PAYMENT_AUTO_SETTLE=true

# Kata sandi semua akun demo saat seed.
SEED_PASSWORD=admin123
