# Sebelumnya https://jernih.id ditulis langsung di src/rute/auth.ts, sehingga
# email dari lokal/staging mengirim pengguna ke situs produksi.
>>>>>>> eb8b001 (fix(bayar): wajibkan tanda tangan webhook dan keluarkan rahasianya dari kode)
APP_URL=http://localhost:3000

# Email (verifikasi, struk token, notifikasi)
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Jernih <noreply@jernih.id>"

# Mode peragaan: beli token langsung lunas + kode token ikut dikirim.
# WAJIB false kalau pembayaran sungguhan dipasang.
PAYMENT_AUTO_SETTLE=true

# Token demo 1111 (+5L) dan 2222 (+10L) lewat API.
# WAJIB false di produksi agar pelanggan tidak bisa menambah saldo tanpa transaksi.
DEMO_TOKEN_ENABLED=false

# Rahasia tanda tangan webhook penyedia pembayaran. WAJIB diisi di produksi.
# Kalau kosong, POST /api/pembayaran/webhook menolak semua permintaan — itu
# disengaja: lebih baik pembayaran tidak terproses daripada siapa pun bisa
# melunasi tagihan orang lain. Jangan pakai nilai contoh ini apa adanya.
PAYMENT_WEBHOOK_SECRET=

# Kata sandi semua akun demo saat seed.
SEED_PASSWORD=admin123
