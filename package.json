{
  "name": "jernih-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jernih — platform transparansi layanan air PDAM. Backend.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "mqtt": "^5.15.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.23.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "ws": "^8.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.12",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.1",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.21.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
